# NVIDIA API Key (NIM trinity council endpoints)
NVIDIA_API_KEY=nvapi-your-key-here

# Voice mode uses the same NVIDIA_API_KEY via NIM hosted speech (gRPC)
# Optional overrides (default is male Jason · Calm):
# NIM_SPEECH_GRPC_URI=grpc.nvcf.nvidia.com:443
# JARVIS_BUTLER_VOICE=Magpie-Multilingual.EN-US.Jason.Calm
# JARVIS_BUTLER_LANGUAGE=en-US

# GitHub PAT for automatic synchronization of skills and evolution logs
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# Jarvis Paths configuration
# Leave JARVIS_WORKSPACE_ROOT empty to auto-detect from the repo layout.
JARVIS_WORKSPACE_ROOT=
JARVIS_DB_PATH=
