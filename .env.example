# NVIDIA API Key (NIM chat + voice)
NVIDIA_API_KEY=nvapi-your-key-here

# GitHub PAT for automatic synchronization of skills and evolution logs
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# Optional web research APIs (Homer falls back to DuckDuckGo/local scrape without these)
# TAVILY_API_KEY=tvly-...
# FIRECRAWL_API_KEY=fc-...

# Jarvis path configuration (leave blank to use defaults)
# JARVIS_WORKSPACE_ROOT=
# JARVIS_DATA_DIR=
# JARVIS_DB_PATH=
# JARVIS_PORT=8008

# Voice mode uses the same NVIDIA_API_KEY via NIM hosted speech (gRPC)
# Defaults: Magpie EN-US Ray.Calm at 0.92 playback rate
# NIM_SPEECH_GRPC_URI=grpc.nvcf.nvidia.com:443
# JARVIS_BUTLER_VOICE=Magpie-Multilingual.EN-US.Ray.Calm
# JARVIS_BUTLER_LANGUAGE=en-US
# JARVIS_VOICE_RATE_SCALE=0.92
